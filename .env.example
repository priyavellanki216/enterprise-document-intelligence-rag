APP_ENV=development
APP_DATA_DIR=./data
DATABASE_URL=sqlite:///./data/app.db
# Required for Compose; replace before any shared deployment.
POSTGRES_PASSWORD=local-only-change-me
# For Compose, set QDRANT_URL=http://qdrant:6333; local default is persistent embedded Qdrant.
QDRANT_URL=
QDRANT_PATH=./data/qdrant
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MAX_UPLOAD_BYTES=25000000
CHUNK_WORDS=220
CHUNK_OVERLAP_WORDS=40
# Local-only sample keys. Replace before any shared use; these are not production credentials.
RAG_API_KEYS=local-admin-change-me:demo:admin,local-viewer-change-me:demo:viewer
LLM_PROVIDER=extractive
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
# Leave blank unless you explicitly enable LLM_PROVIDER=openai-compatible.
OPENAI_API_KEY=
